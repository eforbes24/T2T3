Cell[BoxData[
 RowBox[{
  RowBox[{"R0CYCT2", "[", 
   RowBox[{"k0_", ",", "ds0_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"k", "=", "k0"}], ",", " ", 
      RowBox[{"d", " ", "=", " ", "ds0"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", "Equilibrate", " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"DisplayTrajectories", "[", 
      RowBox[{
       RowBox[{"T2ASI", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"k1", "->", "k"}], ",", 
          RowBox[{"ds", "->", "d"}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"2", ",", "15", ",", "0"}], "}"}], "}"}], ",", "5000", ",", 
       " ", 
       RowBox[{"StateVariables", "->", 
        RowBox[{"{", 
         RowBox[{"A", ",", "S"}], "}"}]}], ",", " ", 
       RowBox[{"MaxSteps", "->", "Infinity"}], ",", 
       RowBox[{"MaxStepSize", "->", "0.01"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "R0", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"DisplayTrajectories", "[", 
      RowBox[{
       RowBox[{"T2ASI", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"k1", "->", "k"}], ",", 
          RowBox[{"ds", "->", "d"}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Last", "[", 
            RowBox[{"First", "[", "$Trajectories", "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"Last", "[", 
            RowBox[{"First", "[", "$Trajectories", "]"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "0"}], "}"}], "}"}], ",", 
       "5000", ",", " ", 
       RowBox[{"StateVariables", "->", 
        RowBox[{"{", 
         RowBox[{"A", ",", "S"}], "}"}]}], ",", " ", 
       RowBox[{"MaxIterations", "->", "Infinity"}], ",", 
       RowBox[{"MaxSteps", "->", "Infinity"}], ",", 
       RowBox[{"MaxStepSize", "->", "0.01"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"r0", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"a", "=", "1"}], ",", 
       RowBox[{"a", "<=", 
        RowBox[{"Length", "[", 
         RowBox[{"$Trajectories", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"a", "++"}], ",", "\[IndentingNewLine]", 
